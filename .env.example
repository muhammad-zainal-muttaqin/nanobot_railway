# Railway provides PORT automatically. Set it only for local runs.
PORT=8080

# Admin dashboard Basic Auth.
# For a published Railway template, set ADMIN_PASSWORD in the template composer
# to ${{ secret(32) }} instead of hardcoding a shared password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Persistent workspace path. The Docker image already defaults to this path;
# attach a Railway volume mounted at /data for durable config and workspace files.
NANOBOT_AGENTS__DEFAULTS__WORKSPACE=/data/.nanobot/workspace

# Optional OpenAI-compatible quickstart. Leave blank if users will configure
# providers from the dashboard after deployment.
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_API_BASE=
OPENAI_COMPATIBLE_MODEL=

# Optional direct provider shortcuts.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional Telegram channel.
TELEGRAM_ENABLED=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=*
TELEGRAM_BOT_TO_BOT=0
TELEGRAM_BOT_TO_BOT_ALLOW_BOTS=
TELEGRAM_BOT_TO_BOT_MAX_PER_MINUTE=12
TELEGRAM_BOT_TO_BOT_MAX_CHAIN_DEPTH=6
