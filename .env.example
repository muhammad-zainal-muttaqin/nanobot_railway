# Railway will usually provide PORT automatically
PORT=8080

# Admin dashboard Basic Auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# Optional: persistent workspace path (Dockerfile already sets this)
NANOBOT_AGENTS__DEFAULTS__WORKSPACE=/data/.nanobot/workspace

# Optional: live Telegram Bot API v10 verifier
# Keep these unset unless you are intentionally running scripts/verify_telegram_live.py.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_TO_BOT_TARGET=@OtherBot
TELEGRAM_GROUP_CHAT_ID=
TELEGRAM_MESSAGE_THREAD_ID=
TELEGRAM_EXPECT_BOT_UPDATE_FROM=@OtherBot
TELEGRAM_UPDATE_POLL_SECONDS=20
TELEGRAM_REQUIRE_BOT_TO_BOT=0
