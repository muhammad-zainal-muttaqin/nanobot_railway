# Railway will usually provide PORT automatically
PORT=8080

# Admin dashboard Basic Auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# Optional: persistent workspace path (Dockerfile already sets this)
NANOBOT_AGENTS__DEFAULTS__WORKSPACE=/data/.nanobot/workspace

# Optional: production config overrides from Railway variables.
# These override dashboard config at runtime without requiring a dashboard save.
TELEGRAM_ENABLED=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=*
TELEGRAM_BOT_TO_BOT=0
TELEGRAM_BOT_TO_BOT_ALLOW_BOTS=
TELEGRAM_BOT_TO_BOT_MAX_PER_MINUTE=12
TELEGRAM_BOT_TO_BOT_MAX_CHAIN_DEPTH=6
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
NANOBOT_PROVIDER=auto
NANOBOT_MODEL=

# Optional: live Telegram Bot API v10 verifier
# Keep these unset unless you are intentionally running scripts/verify_telegram_live.py.
TELEGRAM_BOT_TO_BOT_TARGET=@OtherBot
# Negative group/supergroup chat ID, for example -1001234567890.
TELEGRAM_GROUP_CHAT_ID=
TELEGRAM_MESSAGE_THREAD_ID=
TELEGRAM_EXPECT_BOT_UPDATE_FROM=@OtherBot
TELEGRAM_UPDATE_POLL_SECONDS=20
TELEGRAM_REQUIRE_BOT_TO_BOT=0
